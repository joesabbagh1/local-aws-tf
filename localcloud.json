      "type": "awsNode",
      "parentId": "node-subnet-private",
      "position": {
        "x": 24,
        "y": 60
      },
      "data": {
        "label": "Core Backend Fargate Service",
        "resourceName": "core_backend_fargate",
        "serviceType": "aws_ecs_service",
        "baseConfig": {
          "container_image": "111122223333.dkr.ecr.us-east-1.amazonaws.com/backend:latest",
          "container_port": 8080,
          "cpu": "256",
          "memory": "512",
          "desired_count": 1,
          "assign_public_ip": false,
          "enable_execute_command": true
        },
        "envOverrides": {
          "testing": {
            "desired_count": 2,
            "cpu": "512",
            "memory": "1024"
          },
          "staging": {
            "desired_count": 3,
            "cpu": "1024",
            "memory": "2048"
          },
          "prod": {
            "desired_count": 6,
            "cpu": "2048",
            "memory": "4096",
            "enable_execute_command": false
          }
        },
        "envEnabled": {
          "dev": true,
          "testing": true,
          "staging": true,
          "prod": true
        },
        "tags": {
          "Runtime": "Fargate"
        }
