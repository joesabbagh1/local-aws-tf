    {
      "id": "node-secrets-db",
      "type": "awsNode",
      "position": {
        "x": 916.708819103004,
        "y": -123.12528079449419
      },
      "data": {
        "label": "Database Credentials Vault",
        "resourceName": "db_credentials_secret",
        "serviceType": "aws_secretsmanager_secret",
        "baseConfig": {
          "secret_prefix": "platform/rds/master",
          "recovery_window_in_days": 0,
          "secret_json": "{\"username\":\"postgres_admin\",\"password\":\"local_dev_password_9297\"}"
        },
        "envOverrides": {
          "prod": {
            "recovery_window_in_days": 30
          }
        },
        "envEnabled": {
          "dev": true,
          "testing": true,
          "staging": true,
          "prod": true
        },
        "tags": {
          "Security": "Vault"
        }
      }
