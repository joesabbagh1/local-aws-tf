        "label": "Public Ingress ALB",
        "resourceName": "public_ingress_alb",
        "serviceType": "aws_lb",
        "baseConfig": {
          "load_balancer_type": "application",
          "internal": false,
          "enable_deletion_protection": false,
          "idle_timeout": 60,
          "listener_port": 443,
          "health_check_path": "/healthz"
        },
        "envOverrides": {
          "prod": {
            "enable_deletion_protection": true,
            "idle_timeout": 120
