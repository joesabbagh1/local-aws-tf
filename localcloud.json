      "parentId": "node-subnet-private",
      "position": {
        "x": 24,
        "y": 245
      },
      "data": {
        "label": "Session & Query Cache",
        "resourceName": "session_redis_cache",
        "serviceType": "aws_elasticache_cluster",
        "baseConfig": {
          "engine": "redis",
          "node_type": "cache.t4g.micro",
          "num_cache_nodes": 1,
          "port": 6379
        },
        "envOverrides": {
          "staging": {
            "node_type": "cache.t4g.small",
            "num_cache_nodes": 2
          },
          "prod": {
            "node_type": "cache.r6g.large",
            "num_cache_nodes": 3
          }
        },
        "envEnabled": {
          "dev": true,
          "testing": true,
          "staging": true,
          "prod": true
        },
        "tags": {
          "Cache": "Redis"
        }
      }
